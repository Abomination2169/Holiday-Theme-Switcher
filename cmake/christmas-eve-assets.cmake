# Pin the same inputs as the Christmas Eve v1.0.0 release.
set(_christmas_eve_source "https://raw.githubusercontent.com/Abomination2169/Christmas-Eve-Theme/28c341d4661e97f0424f0cd754da746f3a7c58cf")
function(fetch_christmas_eve_asset source_path destination)
    if(NOT EXISTS "${destination}")
        file(DOWNLOAD "${_christmas_eve_source}/${source_path}" "${destination}.part"
             TLS_VERIFY ON TIMEOUT 60 STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${destination}.part")
            message(FATAL_ERROR "Could not fetch Christmas Eve asset ${source_path}: ${status}")
        endif()
        file(RENAME "${destination}.part" "${destination}")
    endif()
endfunction()
foreach(image solid_e_red christmas_candy_cane_v63 christmas_eve_aurora_v77 christmas_tree_presents_v66 garland_christmas garland_sparkle)
    fetch_christmas_eve_asset("assets/${image}.png" "${CMAKE_CURRENT_SOURCE_DIR}/assets/${image}.png")
endforeach()
fetch_christmas_eve_asset("assets/snowflakes.png" "${CMAKE_CURRENT_SOURCE_DIR}/assets/christmas_eve_snowflakes.png")
foreach(track we_wish_you_a_merry_christmas dance_of_the_sugar_plum_fairy M668_Christmas_Lights_5m22_click_removed christmas-eve-aurora-jingle)
    fetch_christmas_eve_asset("FileCopies/${track}.ogg" "${CMAKE_BINARY_DIR}/${track}.ogg")
endforeach()

set(_christmas_eve_source "https://raw.githubusercontent.com/Abomination2169/New-Years-Theme/6fb54684edf42d614719e8bcebef30d8fe5fda4a")
fetch_christmas_eve_asset("FileCopies/new_year_celebration.ogg" "${CMAKE_BINARY_DIR}/new_year_celebration.ogg")
